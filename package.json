{
  "name": "omp-antigravity-acp-provider",
  "version": "0.1.0-omp.1",
  "description": "Google Antigravity through its official ACP runtime for Oh My Pi (OMP)",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "zacbemis",
    "url": "https://github.com/zacbemis"
  },
  "keywords": [
    "omp-plugin",
    "omp-extension",
    "antigravity",
    "acp",
    "agent-client-protocol"
  ],
  "files": [
    "extensions",
    "src",
    "docs",
    "runtime-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun ./node_modules/vitest/vitest.mjs run --pool=forks",
    "test:watch": "bun ./node_modules/vitest/vitest.mjs --pool=forks",
    "test:real-acp": "OMP_ANTIGRAVITY_ACP_REAL=1 bun ./node_modules/vitest/vitest.mjs run --pool=forks test/real-cli.test.ts",
    "test:real-cli": "npm run test:real-acp",
    "test:live": "OMP_ANTIGRAVITY_ACP_LIVE=1 bun ./node_modules/vitest/vitest.mjs run --pool=forks test/live-authenticated.test.ts",
    "test:qualify": "OMP_ANTIGRAVITY_ACP_QUALIFY=1 bun ./node_modules/vitest/vitest.mjs run --pool=forks test/live-qualification.test.ts",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "test:packed": "node scripts/packed-install-smoke.mjs",
    "refresh:runtime-manifest": "node scripts/refresh-runtime-manifest.mjs",
    "sign:runtime-manifest": "node scripts/sign-runtime-manifest.mjs",
    "prepublishOnly": "npm run check",
    "test:omp": "OMP_ANTIGRAVITY_ACP_LIVE=1 node scripts/verify-local-omp.mjs",
    "install:omp": "omp plugin link ."
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.6.1 <19",
    "@oh-my-pi/pi-coding-agent": ">=18.6.1 <19",
    "@oh-my-pi/omptype": ">=18.6.1 <19",
    "@oh-my-pi/pi-utils": ">=18.6.1 <19"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.19.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.7",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.6.1",
    "@oh-my-pi/pi-coding-agent": "18.6.1",
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/unzipper": "0.10.11",
    "bun": "^1.3.14",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@oh-my-pi/omptype": "18.6.1",
    "@oh-my-pi/pi-utils": "18.6.1"
  },
  "omp": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xztsummer/omp-antigravity-acp-provider.git"
  },
  "homepage": "https://github.com/xztsummer/omp-antigravity-acp-provider#readme",
  "bugs": {
    "url": "https://github.com/xztsummer/omp-antigravity-acp-provider/issues"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/omptype": {
      "optional": true
    },
    "@oh-my-pi/pi-utils": {
      "optional": true
    }
  }
}
